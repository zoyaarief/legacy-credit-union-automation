# Optional: enables live OpenAI Responses API decisions for discovery.
# Without it, the app uses the explicit safe simulator at the same provider seam.
OPENAI_API_KEY=
OPENAI_DISCOVERY_MODEL=gpt-5.4-mini

# Optional locally; required in hosted production. Base64-encoded 32-byte AES key.
EVIDENCE_ENCRYPTION_KEY=
EVIDENCE_KEY_VERSION=v1

# Required for signed agent invocation tickets. Base64-encoded 32-byte HMAC key.
INVOCATION_SIGNING_KEY=

# Set only during a controlled evidence-key rotation window.
EVIDENCE_PREVIOUS_ENCRYPTION_KEY=
EVIDENCE_PREVIOUS_KEY_VERSION=
